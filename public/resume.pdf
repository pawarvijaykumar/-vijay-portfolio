464472\":{\"name\":\"2613464472\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1355972088\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":104,\"id_type\":\"workspace_id\",\"value\":{\"daybreak_red\":\"hidden\",\"rosalind\":\"hidden\",\"daybreak\":\"hidden\",\"sol\":\"hidden\",\"terra\":\"hidden\",\"luna\":\"hidden\"},\"is_device_based\":false,\"passed\":false},\"462023397\":{\"name\":\"462023397\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"detection_source\":\"image_element_probe_v1\",\"memoize_detection_for_session\":false,\"detection_sources\":[\"image_element_probe_v1\",\"parse_visibility_mutation_v1\",\"ad_options_dom_removal_v1\"]},\"is_device_based\":false,\"passed\":false},\"339548201\":{\"name\":\"339548201\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":{\"log_every_ms\":10000,\"ignore_parent_id_mismatch\":false,\"log_every_n_events\":0,\"websocket_idle_timeout_ms\":180000},\"is_device_based\":false,\"passed\":false},\"1623104352\":{\"name\":\"1623104352\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":25,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3586972587\":{\"name\":\"3586972587\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"prompt\":\"The user provided feedback on a previous completion. Use it to generate a new completion. The output should be a standalone response that reflects the feedback without acknowledging it. Do not mention, suggest, or imply that this is a revision, improvement, or result of feedback. Respond in the same language as the original completion, even if the feedback is in another language. Only switch if the feedback explicitly asks you to translate the completion. Here is the feedback:\\n\"},\"is_device_based\":false,\"passed\":false},\"112877228\":{\"name\":\"112877228\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1007700932\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":110,\"id_type\":\"userID\",\"value\":{\"enable_service_connectors\":false,\"citation_output_processor\":true,\"enable_mcps\":false,\"mcps_prompt_override\":\"\",\"enable_toggle_p13n_connectors\":true},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\"},\"is_device_based\":false,\"passed\":false},\"2346390072\":{\"name\":\"2346390072\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":16,\"id_type\":\"userID\",\"value\":{\"pdf_annotations_enabled\":true},\"is_device_based\":false,\"group_name\":\"PDF and DOCX annotations\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3939855767\":{\"name\":\"3939855767\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"userID\",\"value\":{\"section_order\":[]},\"is_device_based\":false,\"passed\":false},\"2688454279\":{\"name\":\"2688454279\",\"rule_id\":\"35Dg2O0a0xbncUKLdHChWi:100.00:6-35Dg2Ml7yf1STvcPCzGEDg\",\"secondary_exposures\":[{\"gate\":\"3214226695\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3942202898\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"4131374858\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"240634109\",\"gateValue\":\"false\",\"ruleID\":\"3Bfrw3Sig4w6HIXSyIYF34\"},{\"gate\":\"2019673878\",\"gateValue\":\"true\",\"ruleID\":\"6dwDOM7dWtwXDDAxkvSo1j:100.00:5\"},{\"gate\":\"2650520192\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"242711730\",\"gateValue\":\"true\",\"ruleID\":\"7tGAs3KJNoUkUi4my1LYRz:100.00:9\"},{\"gate\":\"3197662440\",\"gateValue\":\"false\",\"ruleID\":\"STQR4iHWIVgTPoEhd5Icv:1.00:1\"},{\"gate\":\"654798829\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":193,\"id_type\":\"userID\",\"value\":{\"wingman_model_picker_alternative_options\":[],\"rollout_version\":2,\"home_takeover_animation_enabled\":false,\"rollout_policy\":\"available_default\",\"projects_enabled\":true,\"incall_banner_enabled\":false,\"wingman_model_name\":\"GPT-Live-1\",\"wingman_model_picker_default_display_name\":\"Live\",\"incall_voice_model_picker_available\":false,\"unavailable_upsell_po